{
  "name": "daxlib-audit-cli",
  "version": "0.1.0",
  "description": "Audits a daxlib package folder (manifest.daxlib + lib/functions.tmdl) before submission to https://github.com/daxlib/daxlib",
  "license": "MIT",
  "author": "Juls-BI",
  "bin": {
    "daxlib-audit": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "audit": "npm run build && node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
